# AI-providers (laat leeg om een provider over te slaan)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Modelnamen — controleer actuele namen bij de providers
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.5-flash

# Site (module 2 crawlt SITE_URL; valt terug op WP_BASE_URL)
SITE_URL=https://ci-engineers.com

# WordPress (Hostinger) — zonder username/password werkt alleen lezen
WP_BASE_URL=https://ci-engineers.com
WP_USERNAME=
WP_APP_PASSWORD=

# Google Search Console (module 3) — zie README voor de setup
GSC_SERVICE_ACCOUNT_FILE=config/gsc-service-account.json
GSC_SITE_URL=sc-domain:ci-engineers.com

# E-mail voor het weekrapport (alleen nodig bij: python -m src.report --email)
# Route 1 (aanbevolen): Microsoft 365 / Exchange Online via Graph API — app-registratie in Entra, zie README
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Route 2 (alternatief): klassiek SMTP met wachtwoord; op Exchange Online eind 2026 standaard uitgeschakeld
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Afzender-mailbox en ontvanger(s), komma-gescheiden
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
